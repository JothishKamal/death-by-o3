{"version": 2, "width": 100, "height": 30, "timestamp": 1787375618, "env": {"SHELL": "/bin/bash", "TERM": "xterm-256color"}}
[0.6, "o", "\u001b[1mOptimization Autopsy \u2014 demo\u001b[0m\n"]
[1.2, "o", "-O3 on a 30-line kernel. One decision costs ~5x.\nWe are going to find it, veto it, and prove it.\n\n"]
[0.2356126308441162, "o", "\u001b[1;32msegfault\u001b[0m \u001b[1;34mdeath-by-o3\u001b[0m $ bash -c clang -O3 -fno-discard-value-names -I benchmarks/tierA benchmarks/tierA/A12_simplifycfg_cmov.c -o /tmp/a12_base -lm && clang -O3 -fno-discard-value-names -mllvm -two-entry-phi-node-folding-threshold=0 -mllvm -phi-node-folding-threshold=0 -I benchmarks/tierA benchmarks/tierA/A12_simplifycfg_cmov.c -o /tmp/a12_veto -lm && echo '--- -O3:' && /tmp/a12_base && echo '--- vetoed:' && /tmp/a12_veto\n--- -O3:\nNS_PER_REP 1.2136\nCHECK 8126464\n--- vetoed:\nNS_PER_REP 0.2463\nCHECK 8126464\n"]
[1.4, "o", "\u001b[1;33m=> 4.93x slower with one decision in place. Checksum identical.\u001b[0m\n\n"]
[0.17248821258544922, "o", "\u001b[1;32msegfault\u001b[0m \u001b[1;34mdeath-by-o3\u001b[0m $ .venv/bin/autopsy capture benchmarks/tierA/A12_simplifycfg_cmov.c -o /tmp/demo-cap\n513 invocations, 56 decisions\nevents: /tmp/demo-cap/events.jsonl\ncas:    /tmp/demo-cap/cas\n"]
[1.2, "o", "Every invocation recorded: tree position, occurrence, guard hash, IR metrics, snapshot.\n\n"]
[0.8543176651000977, "o", "\u001b[1;32msegfault\u001b[0m \u001b[1;34mdeath-by-o3\u001b[0m $ .venv/bin/autopsy diagnose benchmarks/tierA/A12_simplifycfg_cmov.c --top 3 -o /tmp/demo-diag\nverdict: RANKED\n  #1 loop-unroll on chain (score 0.529)\n  #2 sroa on report (score 0.297)\n  #3 sroa on main (score 0.282)\nevidence: /tmp/demo-diag/evidence.json\n"]
[0.378887414932251, "o", "\u001b[1;32msegfault\u001b[0m \u001b[1;34mdeath-by-o3\u001b[0m $ .venv/bin/autopsy veto benchmarks/tierA/A12_simplifycfg_cmov.c --pass-name simplifycfg --function chain -o /tmp/demo-veto\ntier            1\nguard matched   True\nprefix ok       True (24 identical records)\nreproduce       clang -O3 -fno-discard-value-names -fpass-plugin=<autopsy> -c A12_simplifycfg_cmov.c   # AUTOPSY_VETO='SimplifyCFGPass|function|chain|chain|1|0x4ae861aae0d47058'\n"]
[1.2, "o", "\u001b[1;32mGuard verified: the veto landed on exactly the addressed invocation,\u001b[0m\nand every record before it is byte-identical.\nThe reproduce command runs on stock clang with no plugin.\n"]
[0.8, "o", "\u001b[1mFull UI: .venv/bin/autopsy serve <src> + web/npm run dev\u001b[0m\n"]
